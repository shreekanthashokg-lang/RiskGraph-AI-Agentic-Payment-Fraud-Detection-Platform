# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=local

# --- Database ---
# Local default (SQLite, zero setup):
DATABASE_URL=sqlite:///./riskgraph.db
# Docker Compose / Postgres:
# DATABASE_URL=postgresql://riskgraph:riskgraph@postgres:5432/riskgraph

REDIS_URL=redis://localhost:6379/0

# --- AI Investigation Agent (Anthropic) ---
# Required for LIVE agent investigations. If unset, the agent automatically
# falls back to DEGRADED_AI_MODE (deterministic rule/graph summary) - the
# rest of the platform (scoring, dashboard, simulator) works either way.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- Artifacts / policy paths (defaults are fine for local runs) ---
MODEL_ARTIFACT_PATH=./ml/artifacts/model.pkl
RULES_POLICY_PATH=./backend/app/policies/rules.yaml
POLICY_DOCS_DIR=./data/policies

# --- API ---
CORS_ALLOW_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
