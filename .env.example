# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Frontend accessible variables ---
VITE_ENVIRONMENT=local

# --- Database ---
# Local default (SQLite, zero setup):
VITE_DATABASE_URL=sqlite:///./riskgraph.db
# Docker Compose / Postgres:
# VITE_DATABASE_URL=postgresql://riskgraph:riskgraph@postgres:5432/riskgraph

VITE_REDIS_URL=redis://localhost:6379/0

# --- AI Investigation Agent (Anthropic) ---
# Required for LIVE agent investigations. If unset, the agent automatically
# falls back to DEGRADED_AI_MODE (deterministic rule/graph summary).
VITE_ANTHROPIC_API_KEY=
VITE_LLM_MODEL=claude-sonnet-4-6
VITE_LLM_TIMEOUT_SECONDS=20
VITE_LLM_MAX_RETRIES=2

# --- Artifacts / policy paths ---
VITE_MODEL_ARTIFACT_PATH=./ml/artifacts/model.pkl
VITE_RULES_POLICY_PATH=./backend/app/policies/rules.yaml
VITE_POLICY_DOCS_DIR=./data/policies

# --- API ---
VITE_CORS_ALLOW_ORIGINS=http://localhost:5173
VITE_RATE_LIMIT_PER_MINUTE=120
